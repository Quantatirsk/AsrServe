# v0.27.1rc1: latest versioned Ascend image checked on 2026-09-27 (release candidate).
ARG VLLM_ASCEND_IMAGE=quay.io/ascend/vllm-ascend:v0.27.1rc1@sha256:4f75925e8f38e6d964768ae340c2433d08003e96fb37ceebc8cab10ec1a9ee06
FROM ghcr.io/astral-sh/uv:0.9.22 AS uv
FROM ${VLLM_ASCEND_IMAGE}
USER root
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/app/models/huggingface \
    HF_HUB_DISABLE_PROGRESS_BARS=1 \
    TOKENIZERS_PARALLELISM=false \
    UV_PROJECT_ENVIRONMENT=/opt/api-venv \
    API_PYTHON=/opt/api-venv/bin/python \
    R2T2_PYTHON=/opt/ascend-python \
    DEVICE=npu:0 \
    ALIGNMENT_MODE=uniform \
    SPEAKER_DIARIZATION_DEVICE=cpu \
    OMP_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    VLLM_NO_USAGE_STATS=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libsndfile1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(command -v python3)" /opt/ascend-python \
    && python3 -m pip freeze > /tmp/ascend-constraints.txt \
    && python3 -m pip install --no-cache-dir -c /tmp/ascend-constraints.txt \
        python-dotenv loguru librosa soundfile websockets \
    && python3 -m pip check
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
# Never install the Nemotron Transformers pin or CPU torch into the NPU environment.
RUN uv sync --frozen --no-dev --no-install-project --extra cpu \
    && uv pip check --python /opt/api-venv/bin/python \
    && /opt/api-venv/bin/python -c "from transformers import Nemotron3DiarizationForAudioFrameClassification, Nemotron3DiarizationProcessor" \
    && /opt/ascend-python -c "import torch_npu, vllm; from vllm.transformers_utils.processors.qwen3_asr import Qwen3ASRProcessor; from vllm.v1.engine.async_llm import AsyncLLM"
COPY app ./app
COPY deploy ./deploy
COPY start.py ./
RUN mkdir -p temp logs
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=600s --retries=3 \
    CMD ["/opt/api-venv/bin/python", "/app/start.py", "--healthcheck"]
ENTRYPOINT ["/opt/api-venv/bin/python", "/app/start.py"]
