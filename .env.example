# Optional overrides; copy to .env and uncomment what you need.
# ASR_GPU=0
# API_KEY=your_api_key_here
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com

# Accelerator memory budget, as a fraction of the whole card (NPU default 0.85).
# R2T2_GPU_MEMORY_UTILIZATION=0.30
# FORCED_ALIGNER_GPU_MEMORY_UTILIZATION=0.15

# CPU threads.
# R2T2_CPU_THREADS=8
# OPENBLAS_NUM_THREADS=8

# Word timing: forced uses the aligner; uniform estimates timing without it.
# Ascend 910B requires uniform; it is selected automatically with DEVICE=npu:0.
# ALIGNMENT_MODE=forced
