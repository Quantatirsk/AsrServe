# Optional overrides. GPU: docker compose up -d --build
# CPU: docker compose -f compose.cpu.yaml up -d --build
# ASR_PORT=17003
# ASR_GPU=0
# API_KEY=your_api_key_here
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com

# GPU memory budget; adjust for your hardware.
# R2T2_GPU_MEMORY_UTILIZATION=0.30
# FORCED_ALIGNER_GPU_MEMORY_UTILIZATION=0.15

# CPU threads; adjust for your hardware.
# R2T2_CPU_THREADS=8
# OPENBLAS_NUM_THREADS=8

# Ascend: docker compose -f docker-compose.yml up -d --build
# DEVICE=npu:0
# ALIGNMENT_MODE=uniform
# SPEAKER_DIARIZATION_DEVICE=cpu
# R2T2_PYTHON=/opt/ascend-python
# API_PYTHON=/opt/api-venv/bin/python
# R2T2_MAX_MODEL_LEN=16384
# R2T2_CHUNK_SECONDS=0.64
# R2T2_ENFORCE_EAGER=1
